---
// Servicios en filas grandes con número y flecha. Los servicios con `detalle` tienen página propia (/servicios/<slug>/):
// el título es el enlace y la fila entera es clicable; los demás siguen como texto.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
import { enlaceDe } from '../../lib/paginas';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <div class="grid gap-10 md:grid-cols-3">
        <Titular class="md:sticky md:top-28 md:self-start" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <ol class="md:col-span-2">
          {s.items.map((it, i) => (
            <li class="group relative grid grid-cols-[auto_1fr] gap-x-5 border-t border-texto/10 py-7 md:grid-cols-[5rem_1fr_auto] md:items-center">
              <span class="font-display text-sm font-bold opacity-50 md:text-base">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-2xl md:text-3xl">{enlaceDe(it) ? <a href={enlaceDe(it)} class="servicio-enlace">{it.titulo}</a> : it.titulo}</h3>
                {it.texto && <p class="mt-2 max-w-xl opacity-65">{it.texto}</p>}
                {enlaceDe(it) && <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-acento md:hidden" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>}
              </div>
              <Icono nombre="flecha" class="hidden text-acento transition-transform group-hover:translate-x-1 md:block" tam={28} />
            </li>
          ))}
        </ol>
      </div>
    </Seccion>
  )
}

<style>
  .servicio-enlace { color: inherit; text-decoration: none; }
  .servicio-enlace::after { content: ""; position: absolute; inset: 0; }
  .servicio-enlace:focus-visible { outline: none; }
  li:has(.servicio-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 2px; border-radius: .5rem; }
  li:has(.servicio-enlace):hover .servicio-enlace { color: var(--c-acento); }
</style>
