---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="contenedor py-24 text-center">
    <p class="antetitulo">Error 404</p>
    <h1 class="titulo-seccion mt-3">Esta página no existe</h1>
    <p class="mt-4 opacity-80">Puede que el enlace esté mal o que la página se haya movido.</p>
    <p class="mt-8"><a class="btn" href="/">Volver al inicio</a></p>
  </section>
</Base>
