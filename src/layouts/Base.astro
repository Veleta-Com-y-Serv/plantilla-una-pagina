---
// Layout base de la plantilla. NO TOCAR salvo orden explícita de diseño.
// Pone el idioma, las metas SEO, los colores de site.yaml como variables CSS, la cabecera y el pie.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { titulo?: string; descripcion?: string }
const { titulo, descripcion } = Astro.props;

const VARIANTE_CABECERA = 'flotante';
const VARIANTE_PIE = 'moderno';

const title = titulo ? `${titulo} · ${site.nombre}` : site.seo.titulo;
const description = descripcion ?? site.seo.descripcion;
const c = site.colores;
const variables = `--c-primario:${c.primario};--c-acento:${c.acento};--c-fondo:${c.fondo};--c-texto:${c.texto}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ld = {
  '@context': 'https://schema.org',
  '@type': site.seo.tipo || 'LocalBusiness',
  name: site.nombre,
  description: site.seo.descripcion,
  ...(site.contacto.telefono && { telephone: site.contacto.telefono }),
  ...(site.contacto.email && { email: site.contacto.email }),
  ...(site.contacto.direccion && { address: site.contacto.direccion }),
  ...(Astro.site && { url: Astro.site.href }),
  sameAs: Object.values(site.redes).filter(Boolean),
};
---

<!doctype html>
<html lang="es-ES" style={variables}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={c.primario} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.nombre} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header variante={VARIANTE_CABECERA} cta={site.boton_cabecera} />
    <main id="contenido">
      <slot />
    </main>
    <Footer variante={VARIANTE_PIE} />
  </body>
</html>
